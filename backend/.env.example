# Copy this file to backend/.env and fill only the services you use.
# Never commit real credentials.

DATABASE_URL=sqlite:///./sentinel.db

# Comma-separated public frontend origins for deployed environments.
# Example: https://fedsentry.example.com,https://www.fedsentry.example.com
ALLOWED_ORIGINS=

# Shared secret used only by trusted FedSentry sensor agents.
# Generate a long random value for deployment and keep it private.
AGENT_API_KEY=

# LLM provider: groq or gemini
# Groq is the recommended default for the local project.
LLM_PROVIDER=groq
GROQ_API_KEY=

# Recommended Groq model for broad project access.
# FedSentry will automatically try other compatible Groq models if this one
# is unavailable to the current Groq project/account.
GROQ_MODEL=openai/gpt-oss-20b

# Optional fallback provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# RAG mode: hybrid, semantic, or lexical
# hybrid uses SentenceTransformers/FAISS when available and automatically
# falls back to local keyword retrieval if the embedding model cannot load.
RAG_MODE=hybrid
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MAX_TOKENS=600

# Optional threat-intelligence enrichment
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Authentication - replace in deployed environments
SECRET_KEY=change-this-to-a-long-random-secret
