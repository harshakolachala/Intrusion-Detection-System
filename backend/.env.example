# Copy this file to backend/.env and fill only the services you use.
# Never commit real credentials.

DATABASE_URL=sqlite:///./sentinel.db

# LLM provider: groq or gemini
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional threat-intelligence enrichment
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Authentication - replace in deployed environments
SECRET_KEY=change-this-to-a-long-random-secret
